{
  "name": "cadbabel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.ppe.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "deploy:ppe": "wrangler deploy --config wrangler.ppe.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply cadbabel-prod --remote --config wrangler.production.jsonc",
    "db:migrate:ppe": "wrangler d1 migrations apply cadbabel-ppe --remote --config wrangler.ppe.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply cadbabel-ppe --local --config wrangler.ppe.jsonc"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.30.0"
  },
  "allowScripts": {
    "workerd@1.20260917.1": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20250906.0": true
  }
}
